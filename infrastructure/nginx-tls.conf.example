# Install in the trusted host gateway, replacing hostname and certificate paths.
# http context; clients must reach this gateway directly, or configure trusted real_ip explicitly.
limit_req_zone $binary_remote_addr zone=mem_login:10m rate=5r/m;
server {
    listen 443 ssl;
    server_name matriculas.example.org;
    ssl_certificate /etc/ssl/mem/fullchain.pem;
    ssl_certificate_key /etc/ssl/mem/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    server_tokens off;
    client_max_body_size 50m;
    add_header Strict-Transport-Security "max-age=31536000" always;
    location = /api/v1/auth/login {
        limit_req zone=mem_login burst=10 nodelay;
        limit_req_status 429;
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
    }
    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_read_timeout 125s;
        proxy_request_buffering off;
    }
}
server {
    listen 80;
    server_name matriculas.example.org;
    return 308 https://matriculas.example.org$request_uri;
}
