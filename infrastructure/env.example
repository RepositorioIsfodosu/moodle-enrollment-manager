# Copiar a .env; sustituir la contraseña antes del despliegue.
POSTGRES_USER=enrollment
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=enrollment

# Sesiones (segundos) y máximo de intentos de autenticación por ventana.
SESSION_TTL_SECONDS=28800
LOGIN_IP_LIMIT=30
LOGIN_ACCOUNT_LIMIT=10
LOGIN_WINDOW_SECONDS=300

# Ejecutar scripts/init-secrets.py para añadir MOODLE_TOKEN_KEYS de forma segura.
# No introducir una clave de ejemplo ni publicar este secreto. Conservarlo junto a los respaldos cifrados.

# Límites de importación y comprobación de participantes (cada página contiene hasta 100).
CSV_MAX_BYTES=10485760
CSV_MAX_ROWS=50000
CSV_MAX_OPERATIONS=100000
VALIDATION_MAX_PAGES=50

# Habilitar sólo tras autorizar una instalación Moodle de pruebas; iniciar cada trabajo explícitamente.
ENROLLMENT_WRITES_ENABLED=false

# Habilitar en producción detrás de HTTPS. false permite desarrollo local HTTP.
SESSION_COOKIE_SECURE=false

# Máximo de filas de resultado por exportación; refinar filtros si se supera.
REPORT_EXPORT_MAX_ROWS=10000
